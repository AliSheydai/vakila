# PostgreSQL connection string
DATABASE_URL=postgresql://vakila:change_me@localhost:5432/vakila

# Session JWT / cookie signing secret (min 32 chars)
SESSION_SECRET=change_me_to_a_long_random_secret_min_32_chars

# Ferzz SMS gateway
FERZZ_TOKEN=your_ferzz_token_here
FERZZ_ENDPOINT=https://gateway.ferzz.ir/send
FERZZ_ACTION=sms
# در توسعه: OTP در کنسول لاگ می‌شود
FERZZ_DEV_BYPASS=true

OTP_LENGTH=5
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# روی ویندوز از 4000 استفاده کنید (3000 اغلب رزرو است)
PORT=4000
APP_URL=http://localhost:4000

COOKIE_SECURE=false
NODE_ENV=development
