# PostgreSQL connection string
DATABASE_URL=postgresql://vakila:change_me@localhost:5432/vakila

# Session JWT / cookie signing secret (min 32 chars)
SESSION_SECRET=change_me_to_a_long_random_secret_min_32_chars

# Ferzz SMS gateway
FERZZ_TOKEN=your_ferzz_token_here
FERZZ_ENDPOINT=https://gateway.ferzz.ir/send
FERZZ_ACTION=sms
# در توسعه: OTP در کنسول لاگ می‌شود
FERZZ_DEV_BYPASS=true

OTP_LENGTH=5
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# روی ویندوز از 4000 استفاده کنید (3000 اغلب رزرو است)
PORT=4000
APP_URL=http://localhost:4000

COOKIE_SECURE=false
NODE_ENV=development

# RustFS (S3-compatible object storage for file attachments)
# Development: RustFS runs via docker compose (./run.sh dev)
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=vakila_rustfs_key
RUSTFS_SECRET_KEY=change_me_rustfs_secret
RUSTFS_BUCKET=vakila-attachments
# Total system storage limit in bytes (default 10 GB)
RUSTFS_STORAGE_LIMIT_BYTES=10737418240
# Max single file size in bytes (default 10 MB)
RUSTFS_MAX_FILE_BYTES=10485760
# Browser origins allowed for direct presigned uploads (comma-separated)
RUSTFS_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# LiveKit video calls (docker compose: ./run.sh dev)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=vakila_livekit_secret_change_in_production
TURN_HOST=localhost
TURN_SECRET=vakila_turn_secret_change_in_production
