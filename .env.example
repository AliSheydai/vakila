# Docker Compose / root orchestration
# پورت اپلیکیشن — روی ویندوز 3000 اغلب رزرو Hyper-V است
APP_PORT=4000

# PostgreSQL credentials (used by compose / local postgres)
POSTGRES_USER=vakila
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vakila
POSTGRES_PORT=5432

# Full connection string (must match POSTGRES_* above)
DATABASE_URL=postgresql://vakila:change_me_strong_password@localhost:5432/vakila
